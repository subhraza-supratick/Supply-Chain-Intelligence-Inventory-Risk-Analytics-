        "lineageTag": "ee46f6e5-0364-4451-b23b-919e51d7005b",
        "measures": [
          {
            "name": "Average Days of Inventory",
            "expression": "AVERAGE(Inventory_Risk_Scores[days_of_inventory])",
            "formatString": "0.0 'Days'",
            "lineageTag": "bf6c6256-9350-4d18-b29d-7acc7c9b46c7"
          },
          {
            "name": "Excess Stock Value",
            "expression": "CALCULATE(SUMX(Inventory_Risk_Scores, Inventory_Risk_Scores[excess_units] * Inventory_Risk_Scores[unit_cost]), Inventory_Risk_Scores[excess_units] > 0)",
            "formatString": "\\₹#,0",
            "lineageTag": "562e2e4d-5dc9-42d4-ad1c-36a7fec235c6"
          },
          {
            "name": "High Risk SKUs",
            "expression": "CALCULATE(COUNTROWS(Inventory_Risk_Scores), Inventory_Risk_Scores[risk_category] = \"High\")",
            "formatString": "#,0",
            "lineageTag": "79241f9d-6d17-4108-9b05-ed9694593938"
          },
          {
            "name": "Average Risk Score",
            "expression": "AVERAGE(Inventory_Risk_Scores[inventory_risk_score])",
            "formatString": "0.0",
            "lineageTag": "3da3f1c2-8f11-471e-896a-180959ad0154"
          },
          {
            "name": "Action Count",
            "expression": "COUNTROWS(Inventory_Risk_Scores)",
            "formatString": "#,0",
            "lineageTag": "8a9778c3-9740-4e34-8a56-b9b0a29454a5"
          }
        ],
        "partitions": [
          {
            "name": "Inventory_Risk_Scores",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Excel.Workbook(File.Contents(\"D:/PROJECTS/DA/DA2/data/processed/supply_chain_powerbi_data.xlsx\"), null, true),",
                "    Inventory_Risk_Scores_Sheet = Source{[Item=\"Inventory_Risk_Scores\",Kind=\"Sheet\"]}[Data],",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Inventory_Risk_Scores_Sheet, [PromoteAllScalars=true])",
                "in",
                "    #\"Promoted Headers\""
              ],
              "type": "m"
            }
          }
        ]
